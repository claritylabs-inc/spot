  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Generate certificate PDFs in exactly one of two modes. Policy mode uses policyId plus a holder and includes all available policy coverages; when the user provides an address, call lookup_address first. Requirements mode uses requirementSourceDocumentId or one requirementId; the saved source supplies the holder and Spot creates the necessary certificates from matching policies with only the relevant coverages. Do not combine these modes. Additional-insured, waiver, primary/non-contributory, loss payee, and mortgagee requests issue only when existing policy evidence supports them; otherwise Spot gates the certificate and returns a drafted broker email.",
    "inputSchema": {
      "properties": {
        "additionalInsuredName": {
          "description": "Name of the requested additional insured when the user asks to add or show one on the certificate.",
          "type": "string",
        },
        "addressLine1": {
          "description": "Certificate holder street address line 1 when the user provides it.",
          "type": "string",
        },
        "addressLine2": {
          "description": "Certificate holder street address line 2 when the user provides it.",
          "type": "string",
        },
        "certificateHolder": {
          "description": "Certificate holder name. Include the address in this block only when the user already provided it.",
          "type": "string",
        },
        "city": {
          "description": "Certificate holder city when provided.",
          "type": "string",
        },
        "country": {
          "description": "Certificate holder country when provided.",
          "type": "string",
        },
        "descriptionOfOperations": {
          "description": "Source-backed description-of-operations wording to place in the certificate description box when the user explicitly provides wording or the policy source facts clearly support operations, locations, covered autos, or special items. Do not invent this wording. Do not use this for generic policy summaries, carrier names, policy numbers, limits, terms, or unsupported endorsement status.",
          "type": "string",
        },
        "explicitReissue": {
          "description": "Set true only when the user explicitly asks to reissue/regenerate a new certificate version even if one already exists for this holder and current policy version",
          "type": "boolean",
        },
        "holderContactName": {
          "description": "Specific certificate holder contact name or attention line when the user provides one",
          "type": "string",
        },
        "holderEmail": {
          "description": "Certificate holder email address only when the user explicitly asks Spot to email/send the certificate or already provides the email. Do not ask for this for ordinary certificate generation.",
          "type": "string",
        },
        "holderPhone": {
          "description": "Certificate holder phone number only when the user provides one",
          "type": "string",
        },
        "policyId": {
          "description": "Policy-mode reference. Omit in requirements mode.",
          "type": "string",
        },
        "postalCode": {
          "description": "Certificate holder postal code when provided.",
          "type": "string",
        },
        "requestText": {
          "description": "The user's full certificate request. Include explicit endorsement-bearing wording only if the user asked for it.",
          "type": "string",
        },
        "requestedEndorsements": {
          "description": "Specific endorsement requests only when the user explicitly asks for them, such as additional insured, waiver of subrogation, primary and non-contributory, loss payee, or mortgagee. Do not invent extra wording.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "requirementId": {
          "description": "Requirements-mode exact requirement ID. Spot uses its connected source and generates only for this requirement.",
          "type": "string",
        },
        "requirementSourceDocumentId": {
          "description": "Requirements-mode source ID returned by lookup_compliance_requirements. The source provides the holder and all active requirements.",
          "type": "string",
        },
        "state": {
          "description": "Certificate holder state/province when provided.",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "generate_coi",
    "securitySchemes": [
      {
        "scopes": [
          "read",
          "write",
        ],
        "type": "oauth2",
      },
