      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "historyPeriod": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string",
              "format": "date"
            },
            "through": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "from",
            "through"
          ]
        }
      },
      "required": []
