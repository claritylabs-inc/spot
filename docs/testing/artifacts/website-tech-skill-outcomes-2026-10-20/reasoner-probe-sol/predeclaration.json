  "definitions": [
    {
      "id": "same_instruction",
      "question": "Does the challenge in `after` show the same written instruction or checkbox label as in `before`?",
      "before": "frame_before",
      "after": "frame_after"
    },
    {
      "id": "same_images",
      "question": "Do `before` and `after` depict the same pictures in the same positions?",
      "scope": "Pictures means depicted photographs, illustrations, logos and puzzle-tile content, rather than the screenshot files or a control's border. Added, removed, moved or replaced picture content is a difference. If both views contain no pictures, their picture content is the same.",
      "before": "frame_before",
      "after": "frame_after"
    },
    {
      "id": "same_selection",
      "question": "Are exactly the same tiles, boxes or checkboxes selected or checked in `after` as in `before`?",
      "scope": "A checkbox, tile or option that is checked or selected in one and not the other is a difference. If neither contains anything selectable that is selected, the unchanged state counts as yes.",
      "before": "frame_before",
      "after": "frame_after"
    },
    {
      "id": "same_control",
      "question": "Do `before` and `after` show the same control, with the same shape, size and position?",
      "before": "target_before",
      "after": "target_after"
    },
    {
      "id": "no_new_mark",
      "question": "Do `before` and `after` contain exactly the same marks?",
      "scope": "Marks include check marks, ticks, spinners, symbols, text and pictures. Any added, removed or replaced mark is a difference. Two empty controls have the same marks. A change of border color alone does not add or remove a mark.",
      "before": "target_before",
      "after": "target_after"
    },
    {
      "id": "style_only",
      "question": "Is every difference between `before` and `after` only a change of color, shade, border or outline?",
      "scope": "Moved, resized, added, removed or replaced shapes, marks or text are not a change of color, shade, border or outline.",
      "before": "target_before",
      "after": "target_after"
    }
  ],
