{
  "name": "@spot/extraction-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Spot policy extraction worker for long-running cl-sdk jobs",
  "packageManager": "npm@11.12.1",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node ../scripts/check-shared-package-versions.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke:router-transport": "node dist/routerTransportSmoke.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@claritylabs/cl-router-policy": "0.4.0",
    "@claritylabs/cl-sdk": "4.6.0",
    "@llamaindex/liteparse": "^2.0.3",
    "convex": "^1.32.0",
    "dayjs": "^1.11.19",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "zod": "^4.3.6"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0"
  }
}
