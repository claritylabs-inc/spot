{
  "name": "spot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 8080",
    "brand:export": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-spot-brand-assets.mjs",
    "conductor:setup": "node scripts/setup-conductor-workspace.mjs",
    "conductor:setup:cloud": "node scripts/setup-conductor-cloud.mjs",
    "conductor:archive": "node scripts/archive-conductor-workspace.mjs",
    "conductor:dev": "node scripts/run-conductor-dev.mjs",
    "conductor:spectrum": "node scripts/run-conductor-imessage-terminal.mjs",
    "conductor:operator-spectrum": "node scripts/run-conductor-operator-imessage-terminal.mjs",
    "conductor:emails": "node scripts/watch-conductor-email-captures.mjs",
    "conductor:slack-fixture": "node scripts/send-conductor-slack-fixture.mjs",
    "slack:provision-apps": "node scripts/provision-slack-apps.mjs",
    "check:cl-router-contract": "node scripts/check-cl-router-contract.mjs",
    "check:shared-package-versions": "node scripts/check-shared-package-versions.mjs",
    "prebuild": "npm run check:shared-package-versions",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:agent-workers": "npm --prefix imessage-worker run build && npm --prefix slack-worker run build && npm --prefix extraction-worker run build && node --check mailbox-scan-worker/src/index.js",
    "fireworks:parity": "node scripts/fireworks-parity-harness.mjs",
    "check:agent-health": "node scripts/check-agent-deployment-health.mjs --env production",
    "check:agent-health:prod": "node scripts/check-agent-deployment-health.mjs --env production",
    "check:agent-health:local": "node scripts/check-agent-deployment-health.mjs --env local",
    "container:doctor": "node scripts/check-container-cli.mjs",
    "container:system:start": "container system start",
    "container:build:workers": "npm run container:build:extraction-worker && npm run container:build:imessage-worker && npm run container:build:slack-worker && npm run container:build:mailbox-scan-worker",
    "container:build:extraction-worker": "container build --platform linux/amd64 --tag spot-extraction-worker:local --file extraction-worker/Dockerfile extraction-worker",
    "container:build:imessage-worker": "container build --platform linux/amd64 --tag spot-imessage-worker:local --file imessage-worker/Dockerfile imessage-worker",
    "container:build:slack-worker": "container build --platform linux/amd64 --tag spot-slack-worker:local --file slack-worker/Dockerfile slack-worker",
    "container:build:mailbox-scan-worker": "container build --platform linux/amd64 --tag spot-mailbox-scan-worker:local --file mailbox-scan-worker/Dockerfile mailbox-scan-worker",
    "container:run:extraction-worker": "container run --arch amd64 --rm --env-file extraction-worker/.env -e PORT=8080 -p 8080:8080 spot-extraction-worker:local",
    "container:run:imessage-worker": "container run --arch amd64 --rm --env-file imessage-worker/.env -e PORT=3001 -p 3001:3001 spot-imessage-worker:local",
    "container:run:slack-worker": "container run --arch amd64 --rm --env-file slack-worker/.env -e PORT=3002 -p 3002:3002 spot-slack-worker:local",
    "container:run:mailbox-scan-worker": "container run --arch amd64 --rm --env-file mailbox-scan-worker/.env spot-mailbox-scan-worker:local",
    "operator:mcp": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/setup-operator-mcp.mjs",
    "operator:provision-broker": "npm --prefix operator-cli run build --silent && node operator-cli/dist/index.js provision-broker",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/cohere": "^3.0.30",
    "@ai-sdk/deepseek": "^2.0.28",
    "@ai-sdk/fireworks": "^2.0.57",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/mistral": "^3.0.30",
    "@ai-sdk/openai": "^3.0.52",
    "@ai-sdk/openai-compatible": "^2.0.51",
    "@ai-sdk/provider-utils": "^4.0.23",
    "@ai-sdk/xai": "^3.0.83",
    "@auth/core": "^0.37.4",
    "@base-ui/react": "^1.4.1",
    "@claritylabs/cl-pipelines": "0.1.0",
    "@claritylabs/cl-router-policy": "0.4.0",
    "@claritylabs/cl-sdk": "4.6.0",
    "@claritylabs/cl-sync": "^0.1.1",
    "@convex-dev/auth": "^0.0.91",
    "@convex-dev/migrations": "^0.3.5",
    "@lisse/core": "0.6.2",
    "@mapbox/search-js-react": "^1.5.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@rive-app/react-webgl2": "^4.27.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/mailparser": "^3.4.6",
    "@types/pdfkit": "^0.17.5",
    "@types/three": "^0.183.1",
    "@xyflow/react": "^12.10.1",
    "ai": "^6.0.134",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.41.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "email-forward-parser": "^1.8.3",
    "email-reply-parser": "^2.3.9",
    "embla-carousel-react": "^8.6.0",
    "fast-png": "8.0.0",
    "framer-motion": "^12.35.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "html-to-text": "^10.0.1",
    "imapflow": "^1.4.2",
    "jszip": "^3.10.1",
    "libphonenumber-js": "^1.13.0",
    "lucide-react": "^0.577.0",
    "mailparser": "^3.9.11",
    "mammoth": "^1.12.0",
    "marked": "^18.0.11",
    "media-chrome": "^4.18.2",
    "motion": "^12.38.0",
    "nanoid": "^5.1.7",
    "next": "16.2.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "pdfkit": "^0.17.2",
    "playwright": "^1.59.1",
    "react": "19.2.3",
    "react-colorful": "^5.6.1",
    "react-dom": "19.2.3",
    "react-icons": "^5.6.0",
    "react-jsx-parser": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-moveable": "^0.56.0",
    "react-pdf": "^10.4.1",
    "react-phone-number-input": "^3.4.16",
    "react-resizable-panels": "^4.12.1",
    "read-excel-file": "^9.2.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.7",
    "shiki": "^4.0.2",
    "simple-icons": "^16.17.0",
    "sonner": "^2.0.7",
    "svix": "^1.86.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "undici": "8.9.0",
    "use-stick-to-bottom": "^1.1.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.5",
    "ajv": "^8.18.0",
    "concurrently": "^10.0.3",
    "convex-test": "^0.0.49",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "happy-dom": "^20.10.6",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5",
    "zod": "^4.3.6"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
