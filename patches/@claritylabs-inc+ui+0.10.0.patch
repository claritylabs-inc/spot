+"use client"
+
+import * as React from "react"
+import dayjs from "dayjs"
+import customParseFormat from "dayjs/plugin/customParseFormat"
+import { CalendarIcon } from "lucide-react"
+import { Button } from "./button"
+import { Calendar } from "./calendar"
+import { Field, FieldLabel } from "./field"
+import { InputGroup, InputGroupInput, InputGroupAddon, InputGroupButton } from "./input-group"
+import { Popover, PopoverContent, PopoverTrigger } from "./popover"
+import { cn } from "../lib/utils"
+
+dayjs.extend(customParseFormat)
+
+function parseDateText(text: string): string {
+  for (const format of ["MM/DD/YYYY", "YYYY-MM-DD"]) {
+    const date = dayjs(text.trim(), format, true)
+    if (date.isValid()) return date.format("YYYY-MM-DD")
+  }
+  return ""
+}
+
+type DateFieldProps = {
+  id: string
+  label: string
+  /** ISO calendar date, without timezone conversion; empty means no selection. */
+  value: string
+  onChange: (value: string) => void
+  /** Optional controlled text for preserving partially typed dates. */
+  inputValue?: string
+  onInputChange?: (text: string) => void
+  hideLabel?: boolean
+  disabled?: boolean
+  className?: string
+}
+
+function DateField({ id, label, value, onChange, inputValue, onInputChange, hideLabel = false, disabled, className }: DateFieldProps) {
+  const [open, setOpen] = React.useState(false)
+  const [draft, setDraft] = React.useState({ value, text: value ? dayjs(value).format("MM/DD/YYYY") : "" })
+  if (draft.value !== value) setDraft({ value, text: value ? dayjs(value).format("MM/DD/YYYY") : "" })
+  const text = inputValue ?? draft.text
+  const selected = value && dayjs(value).isValid() ? dayjs(value).toDate() : undefined
+  const invalid = !!text && !parseDateText(text)
+  return (
+    <Field>
+      <FieldLabel htmlFor={id} className={hideLabel ? "sr-only" : undefined}>{label}</FieldLabel>
+      <Popover open={open} onOpenChange={setOpen}>
+        <InputGroup className={cn("h-12", className)}>
+          <InputGroupInput id={id} value={text} inputMode="numeric" maxLength={10} placeholder="MM/DD/YYYY" disabled={disabled} aria-invalid={invalid || undefined}
+            onChange={(event) => {
+              const digits = event.target.value.replace(/[^0-9]/g, "").slice(0, 8)
+              const next = [digits.slice(0, 2), digits.slice(2, 4), digits.slice(4)].filter(Boolean).join("/")
+              setDraft({ value, text: next })
+              if (onInputChange) onInputChange(next)
+              else {
+                const date = parseDateText(next)
+                if (date || !next) onChange(date)
+              }
+            }} />
+          <InputGroupAddon align="inline-end">
+            <PopoverTrigger render={<InputGroupButton size="icon-sm" disabled={disabled} aria-label={`Choose ${label.toLowerCase()}`} />}>
+              <CalendarIcon aria-hidden="true" className="size-4" />
+            </PopoverTrigger>
+          </InputGroupAddon>
+        </InputGroup>
+        <PopoverContent align="end" className="w-auto p-0">
+          <Calendar className="p-3 [--cell-size:--spacing(9)] sm:[--cell-size:--spacing(11)] [&_button]:text-base [&_th]:text-sm [&_.rdp-caption_label]:text-lg" mode="single" selected={selected} defaultMonth={selected} autoFocus onSelect={(date) => {
+            const next = date ? dayjs(date).format("YYYY-MM-DD") : ""
+            setDraft({ value: next, text: date ? dayjs(date).format("MM/DD/YYYY") : "" })
+            onChange(next)
+            setOpen(false)
+          }} />
+          <div className="border-t p-3">
+            <Button variant="ghost" className="h-11 w-full text-base" disabled={!text && !value} onClick={() => {
+              setDraft({value: "", text: ""})
+              onInputChange?.("")
+              onChange("")
+              setOpen(false)
+            }}>Clear</Button>
+          </div>
+        </PopoverContent>
+      </Popover>
+    </Field>
+  )
+}
+
+export { DateField, parseDateText }
+export type { DateFieldProps }
