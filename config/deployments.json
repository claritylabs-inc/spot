{
  "production": {
    "branch": "main",
    "spotEnv": "production",
    "convexAgentHealthUrl": "https://actions.spot.insure/agent-health",
    "clientPortalUrl": "https://app.spot.insure",
    "clRouterHealthUrlEnv": "SPOT_PRODUCTION_CL_ROUTER_HEALTH_URL",
    "slack": {
      "appId": "A0BMW4TG7JB",
      "enabled": true,
      "mode": "slack"
    },
    "operatorSlack": {
      "required": true
    },
    "imessage": {
      "webhookTransport": true
    },
    "operatorImessage": {
      "required": true,
      "webhookTransport": true
    },
    "email": {
      "deliveryMode": "live",
      "agentDomain": "agent.spot.insure",
      "notificationDomain": "notifications.spot.insure",
      "authDomain": "auth.spot.insure"
    }
  },
  "local": {
    "branch": "*",
    "spotEnv": "local",
    "convexAgentHealthUrl": "http://localhost:3210/agent-health",
    "clientPortalUrl": "http://localhost:8080",
    "slack": {
      "enabled": true,
      "mode": "mock"
    },
    "operatorSlack": {
      "required": true
    },
    "operatorImessage": {
      "required": false
    },
    "email": {
      "deliveryMode": "capture"
    }
  }
}
