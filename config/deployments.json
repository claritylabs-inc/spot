{
  "production": {
    "branch": "main",
    "spotEnv": "production",
    "convexAgentHealthUrl": "https://actions.spot.insure/agent-health",
    "clientPortalUrl": "https://app.spot.insure",
    "clRouterHealthUrlEnv": "SPOT_PRODUCTION_CL_ROUTER_HEALTH_URL",
    "imessageWorkerHealthUrl": "https://spot-production-4618.up.railway.app/health",
    "operatorImessageWorkerHealthUrlEnv": "SPOT_PRODUCTION_OPERATOR_IMESSAGE_WORKER_HEALTH_URL",
    "slackWorkerHealthUrlEnv": "SPOT_PRODUCTION_SLACK_WORKER_HEALTH_URL",
    "slack": {
      "appId": "A0BMW4TG7JB",
      "enabled": true,
      "mode": "slack",
      "required": true
    },
    "operatorSlack": {
      "required": true
    },
    "imessage": {
      "channelRole": "customer",
      "transport": "imessage",
      "imessageEnabled": true,
      "photonConfigured": true,
      "requiredHttpPorts": [3001]
    },
    "operatorImessage": {
      "required": true,
      "serviceName": "operator-imessage-worker",
      "rootDirectory": "/imessage-worker",
      "railwayConfig": "imessage-worker/railway.operator.json",
      "channelRole": "operator",
      "transport": "imessage",
      "imessageEnabled": true,
      "photonConfigured": true,
      "requiredHttpPorts": []
    },
    "email": {
      "deliveryMode": "live",
      "agentDomain": "agent.spot.insure",
      "notificationDomain": "notifications.spot.insure",
      "authDomain": "auth.spot.insure"
    }
  },
  "local": {
    "branch": "*",
    "spotEnv": "local",
    "convexAgentHealthUrl": "http://localhost:3210/agent-health",
    "clientPortalUrl": "http://localhost:8080",
    "imessageWorkerHealthUrl": "http://localhost:3001/health",
    "slackWorkerHealthUrl": "http://localhost:8085/health",
    "slack": {
      "enabled": true,
      "mode": "mock",
      "required": true
    },
    "operatorSlack": {
      "required": true
    },
    "imessage": {
      "channelRole": "customer",
      "transport": "terminal",
      "imessageEnabled": false,
      "photonConfigured": false,
      "requiredHttpPorts": []
    },
    "operatorImessage": {
      "required": false,
      "channelRole": "operator",
      "transport": "terminal",
      "imessageEnabled": false,
      "photonConfigured": false,
      "requiredHttpPorts": []
    },
    "email": {
      "deliveryMode": "capture"
    }
  }
}
